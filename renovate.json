{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"helpers:pinGitHubActionDigestsToSemver",
		":semanticCommits",
		"security:minimumReleaseAgeNpm"
	],
	"automerge": true,
	"constraints": {
		"npm": "^11"
	},
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true,
		"schedule": ["before 12pm on monday"]
	}
}
